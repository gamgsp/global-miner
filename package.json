{
  "name": "global-miner",
  "version": "1.0.0",
  "description": "Multi-Platform Universal Mining Client with Zero-Downtime Stratum Failover and GSPC Mining Rebates",
  "main": "cli/index.js",
  "bin": {
    "global-miner": "./cli/index.js",
    "gminer": "./cli/index.js"
  },
  "scripts": {
    "start": "node cli/index.js",
    "cli": "node cli/index.js",
    "daemon": "node cli/index.js --daemon",
    "test": "node cli/index.js --test && node test/simulator.js",
    "test:simulator": "node test/simulator.js",
    "gui": "electron gui/main.js",
    "service:install": "node cli/autoStart.js install",
    "service:uninstall": "node cli/autoStart.js uninstall",
    "service:status": "node cli/autoStart.js status",
    "build:linux": "bash build-scripts/build-linux.sh",
    "build:win": "bash build-scripts/build-windows.sh",
    "build:mac": "bash build-scripts/build-mac.sh",
    "build:all": "node build-scripts/build-all.js"
  },
  "keywords": [
    "mining",
    "stratum",
    "crypto",
    "failover",
    "gspc",
    "randomx",
    "kawpow",
    "etchash",
    "autolykos2",
    "ghostrider"
  ],
  "author": "Global Ads Media, LLC",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
